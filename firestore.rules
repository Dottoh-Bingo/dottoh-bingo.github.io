rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per team board: rooms/<id from the team name>
    // Teams are open: anyone can list and read them (the overview page) and tick tiles.
    // Nobody can delete a team.
    match /rooms/{room} {
      allow get, list: if true;
      allow delete: if false;
      allow create, update: if room.matches('^[a-z0-9-]{12,40}$')
        && request.resource.data.keys().hasOnly(['order', 'done', 'updated', 'name', 'members'])
        && request.resource.data.order is list
        && request.resource.data.order.size() == 25
        && request.resource.data.done is map
        && request.resource.data.done.size() <= 25
        && (!('name' in request.resource.data)
            || (request.resource.data.name is string && request.resource.data.name.size() <= 40))
        && (!('members' in request.resource.data)
            || (request.resource.data.members is map && request.resource.data.members.size() <= 50));
    }
  }
}
